[Unit]
Description=Celery Worker telemetry (ingesta/agregacion de eventos OTT)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=wind
WorkingDirectory=/opt/panaccess-wind
EnvironmentFile=/opt/panaccess-wind/.env
ExecStart=/opt/panaccess-wind/env/bin/celery -A panaccess_wind_integration worker -Q telemetry -c 1 --loglevel=info -n telemetry@%H
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
